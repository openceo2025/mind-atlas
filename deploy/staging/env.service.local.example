MIND_ATLAS_MINIMAX_MODELS=minimax-staging-model,minimax-staging-alt
MIND_ATLAS_GROK_MODELS=grok-staging-model,grok-staging-alt

MIND_ATLAS_MODEL_PRICES_JSON={"openai:*":{"inputUsdPer1M":1.5,"outputUsdPer1M":8},"anthropic:*":{"inputUsdPer1M":3,"outputUsdPer1M":15},"glm:*":{"inputUsdPer1M":0.3,"outputUsdPer1M":1.2},"deepseek:*":{"inputUsdPer1M":0.3,"outputUsdPer1M":1.2},"gemini:*":{"inputUsdPer1M":1.25,"outputUsdPer1M":10},"qwen:*":{"inputUsdPer1M":0.4,"outputUsdPer1M":1.6},"composer:*":{"inputUsdPer1M":1,"outputUsdPer1M":4},"kimi:*":{"inputUsdPer1M":0.6,"outputUsdPer1M":2.5},"mimo:*":{"inputUsdPer1M":0.6,"outputUsdPer1M":2.5},"minimax:*":{"inputUsdPer1M":0.6,"outputUsdPer1M":2.5},"grok:*":{"inputUsdPer1M":3,"outputUsdPer1M":15}}
MIND_ATLAS_MODEL_PRICE_POLICY=require-provider
MIND_ATLAS_PROVIDER_MODEL_FETCH=1
MIND_ATLAS_PROVIDER_MODEL_CACHE_MS=300000
MIND_ATLAS_PROVIDER_MODEL_REFRESH_MS=300000
MIND_ATLAS_PROVIDER_MODEL_FETCH_TIMEOUT_MS=10000
MIND_ATLAS_PROVIDER_MODEL_MAX_COUNT=80

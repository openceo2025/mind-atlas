DATABASE_URL=postgres://mindatlas:mindatlas-staging@postgres:5432/mindatlas

MIND_ATLAS_SERVICE_HOST=0.0.0.0
MIND_ATLAS_SERVICE_PORT=8788
MIND_ATLAS_PUBLIC_ORIGIN=http://127.0.0.1:8088
MIND_ATLAS_DIST_DIR=dist
MIND_ATLAS_COOKIE_SECURE=0
MIND_ATLAS_ALLOWED_ORIGIN=http://127.0.0.1:8088,http://localhost:8088
MIND_ATLAS_ANALYTICS_ENABLED=0
MIND_ATLAS_CLIENT_ANALYTICS_ENABLED=0
MIND_ATLAS_ANALYTICS_HMAC_KEY=staging-local-analytics-key-replace-before-enabling
MIND_ATLAS_ANALYTICS_EVENT_MAX_BYTES=32768
MIND_ATLAS_ANALYTICS_IP_MAX=60
MIND_ATLAS_ANALYTICS_LOG_DIR=/var/log/nginx
MIND_ATLAS_ANALYTICS_LOG_PREFIX=mind-atlas-analytics.log

# Next real-service step:
# Set these Google values after creating a Google OAuth web client.
# Authorized JavaScript origin:
#   http://127.0.0.1:8088
# Authorized redirect URI:
#   http://127.0.0.1:8088/api/auth/google/callback
MIND_ATLAS_STAGING_MOCK_AUTH=0
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Keep billing and provider APIs mocked while testing real Google login.
MIND_ATLAS_STAGING_MOCK_BILLING=1
MIND_ATLAS_STAGING_MOCK_PROVIDERS=1
MIND_ATLAS_STAGING_MOCK_EMAIL=staging-user@example.test
MIND_ATLAS_STAGING_MOCK_NAME=Staging User

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=mock_price_monthly_10_usd

MIND_ATLAS_OPENAI_API_KEY=mock
MIND_ATLAS_ANTHROPIC_API_KEY=mock
MIND_ATLAS_GLM_API_KEY=mock
MIND_ATLAS_DEEPSEEK_API_KEY=mock
MIND_ATLAS_GEMINI_API_KEY=mock
MIND_ATLAS_QWEN_API_KEY=mock
MIND_ATLAS_COMPOSER_API_KEY=mock
MIND_ATLAS_KIMI_API_KEY=mock
MIND_ATLAS_MIMO_API_KEY=mock
MIND_ATLAS_MINIMAX_API_KEY=mock
MIND_ATLAS_GROK_API_KEY=mock

MIND_ATLAS_OPENAI_MODELS=openai-staging-model,openai-staging-alt
MIND_ATLAS_ANTHROPIC_MODELS=anthropic-staging-model,anthropic-staging-alt
MIND_ATLAS_GLM_MODELS=glm-staging-model,glm-staging-alt
MIND_ATLAS_DEEPSEEK_MODELS=deepseek-staging-model,deepseek-staging-alt
MIND_ATLAS_GEMINI_MODELS=gemini-staging-model,gemini-staging-alt

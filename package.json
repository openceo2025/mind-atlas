{
  "name": "mind-atlas",
  "version": "0.1.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:bridge": "node scripts/mind-atlas-bridge.mjs",
    "service:start": "node server/mind-atlas-service.mjs",
    "service:migrate": "node server/admin.mjs migrate",
    "service:admin": "node server/admin.mjs",
    "ops:kpi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops-kpi.ps1",
    "staging:local:up": "docker compose -f docker-compose.staging.yml -f docker-compose.staging.local.yml up --build -d",
    "staging:local:down": "docker compose -f docker-compose.staging.yml -f docker-compose.staging.local.yml down",
    "staging:google:doctor": "node scripts/verify-google-staging-ready.mjs",
    "staging:stripe:doctor": "node scripts/verify-stripe-staging-ready.mjs",
    "staging:openai:doctor": "node scripts/verify-openai-staging-ready.mjs",
    "staging:providers:doctor": "node scripts/verify-core-provider-staging-ready.mjs",
    "staging:ui:doctor": "node scripts/verify-live-staging-ui.mjs",
    "staging:e2e:doctor": "node scripts/verify-live-staging-e2e.mjs",
    "staging:verify": "node scripts/verify-staging-service.mjs",
    "build": "node scripts/generate-i18n-runtime.mjs && tsc -b && vite build --configLoader runner && node scripts/build-localized-pages.mjs",
    "build:hosted": "node scripts/build-hosted-public.mjs",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc -b",
    "verify:context": "node --experimental-strip-types scripts/verify-context-assembly.ts",
    "verify:context-engine": "node --experimental-strip-types scripts/verify-context-engine.ts",
    "verify:agent-recovery": "node scripts/verify-agent-run-inbox.mjs",
    "verify:agent-runtime": "node scripts/verify-agent-runtime.mjs",
    "verify:hosted-public-ui": "node scripts/verify-hosted-public-ui.mjs",
    "verify:hosted-dist": "node scripts/verify-hosted-dist.mjs",
    "verify:hosted-service": "node scripts/verify-hosted-service.mjs",
    "verify:analytics": "node scripts/verify-analytics.mjs && node scripts/verify-promotion-attribution.mjs",
    "verify:title-maintenance": "node --experimental-strip-types scripts/verify-title-maintenance.ts",
    "verify:templates": "node --experimental-strip-types scripts/verify-notebook-templates.ts",
    "verify:layout": "node --experimental-strip-types scripts/verify-layout.ts",
    "verify:node-search": "node --experimental-strip-types scripts/verify-node-search.ts",
    "verify:node-error-acknowledgement": "node --experimental-strip-types scripts/verify-node-error-acknowledgement.ts",
    "verify:ui": "node scripts/verify-ui.mjs",
    "i18n:verify": "node --experimental-strip-types scripts/verify-i18n.ts && node scripts/i18n-scan-hardcoded.mjs",
    "i18n:scan": "node scripts/i18n-scan-hardcoded.mjs",
    "i18n:baseline": "node scripts/i18n-scan-hardcoded.mjs --update-baseline",
    "i18n:job": "node --experimental-strip-types scripts/i18n-create-job.ts",
    "i18n:merge": "node --experimental-strip-types scripts/i18n-merge-job.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "fflate": "^0.8.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.475.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-intl": "^10.1.16",
    "three": "^0.173.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.16.13",
    "@formatjs/icu-messageformat-parser": "^3.5.14",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.0",
    "parse5": "^8.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
